# Optional: use a custom persistent SQLite database path.
# FIXFORWARD_DB_PATH=./data/fixforward.db
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Optional: enable GPT-OSS tool calling through Amazon Bedrock Mantle.
# Create a Bedrock API key in AWS and store it here locally; never commit real secrets.
# For Bedrock Mantle, use openai.gpt-oss-20b (no -1:0 suffix).
AI_PROVIDER=local
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
AWS_BEARER_TOKEN_BEDROCK=
# Optional alternate name for the same API key:
OPENAI_API_KEY=
# Optional override; normally leave unset.
# BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
